{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src",
    "api",
    "proxy.ts",
    "vite.config.ts",
    "tailwind.config.ts",
    "scripts/download-kuromoji-dict.ts"
  ],
  "exclude": ["dist", "node_modules", "blogdb", "public"]
}
